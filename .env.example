# --- Spotify -------------------------------------------------------------
# https://developer.spotify.com/dashboard -> Create app.
# Redirect URI is irrelevant here (we only use the client-credentials flow),
# but the dashboard demands one: http://localhost:4870/callback works.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deezer --------------------------------------------------------------
# https://developers.deezer.com/myapps -> Create a new application.
#   Application domain : localhost
#   Redirect URL after authentication : http://localhost:4870/api/deezer/callback
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# Optional
PORT=4870
