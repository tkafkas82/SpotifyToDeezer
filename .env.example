# Everything here is OPTIONAL. With an empty file the app reads Spotify's public
# pages, is a single-user tool on this machine, and writes to Deezer through a
# pasted session cookie - no registrations at all.

# --- Google sign-in (optional) -------------------------------------------
# Setting these two turns the app multi-user: the page asks for a Google sign-in
# and every account connects its own Deezer, kept encrypted in data/users.json.
# Leave them empty and nothing changes - one machine, one user, no sign-in.
#
# https://console.cloud.google.com/apis/credentials
#   Create credentials -> OAuth client ID -> Web application
#   Authorised redirect URI : http://localhost:4870/api/auth/google/callback
#                             (or PUBLIC_URL + /api/auth/google/callback)
#   OAuth consent screen: scopes are just the default openid/email/profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if the callback has to differ from PUBLIC_URL + the path above.
GOOGLE_REDIRECT_URI=

# Who may sign in: addresses and/or whole domains, comma separated. EMPTY MEANS
# ANYBODY with a Google account, which is fine on localhost and a bad idea on a
# public URL - each of them can then connect their own Deezer through your server.
ALLOWED_EMAILS=

# The origin the app is reached at. Redirect URIs are built from it, and https
# here is what marks the session cookie Secure. Defaults to http://localhost:PORT.
PUBLIC_URL=

# Key for session cookies and for the stored Deezer credentials. Generated into
# data/secret.key on first run if unset; set it explicitly and a container can be
# rebuilt without signing everybody out. Changing it invalidates both.
APP_SECRET=

# Where the data directory lives (cache, users, key, browser profile).
# Defaults to ./data - set it to a mounted volume when running in a container.
SD_DATA_DIR=

# --- Where the records live (optional) -----------------------------------
# Set these and the per-user records move from data/users.json into Redis over
# HTTP, which is what a serverless host needs: no writable disk, and a second
# instance that must see the same accounts. Vercel's KV/Upstash integration sets
# KV_REST_API_* for you; a database created directly at Upstash names the same two
# values UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN, and both are read.
# APP_SECRET is required once these are set - the app refuses to start without it.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Spotify (optional) --------------------------------------------------
# Adds exact ISRC matching and lifts the 100-track ceiling of the public pages.
# https://developer.spotify.com/dashboard -> Create app. Any redirect URI will do.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deezer (optional) ---------------------------------------------------
# A registered app is the documented, stable way to write playlists. Each
# signed-in user authorises it against their own Deezer account.
# https://developers.deezer.com/myapps -> Create a new application
#   Application domain : localhost
#   Redirect URL       : http://localhost:4870/api/deezer/callback
DEEZER_APP_ID=
DEEZER_APP_SECRET=

# --- Deezer without an app (optional) ------------------------------------
# The same cookie the app asks for on its own page; setting it here just means you
# do not have to paste it in the UI. From a logged-in deezer.com: DevTools ->
# Application -> Cookies -> arl. Treat it like a password - it IS your Deezer
# session. It applies to the single-user mode only: with Google sign-in on, a
# machine-wide cookie would hand your Deezer to whoever signed in.
DEEZER_ARL=

PORT=4870
